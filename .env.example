# GEMINI_API_KEY: Required for Gemini AI multimodal video analysis and captions.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via Settings > Secrets in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_COOKIE: Optional Netscape or Cookie header string for authorized YouTube
# live stream ingestion when running from cloud datacenter IPs that trigger YouTube bot checks.
YOUTUBE_COOKIE=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ZERNIO_API_KEY: Optional Zernio API key for multi-platform publishing (TikTok, YouTube, Instagram, etc.).
# You can also connect via Sign in with Zernio inside the app UI.
ZERNIO_API_KEY=""
